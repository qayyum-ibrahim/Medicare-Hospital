# Copy this file to a new file named .env in this same folder, then put your own values in.
# NEVER commit .env or paste its contents anywhere. .env is already ignored by git.

# Your MongoDB Atlas connection string. Add the database name "meridian" after the host,
# before the "?", like this:
# mongodb+srv://USERNAME:PASSWORD@CLUSTER-HOST.mongodb.net/meridian?retryWrites=true&w=majority
MONGODB_URI=

# Port the API listens on
PORT=4000