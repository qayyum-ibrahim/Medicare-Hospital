# Copy this file to a new file named .env in this same folder, then put your own values in.
# NEVER commit .env or paste its contents anywhere. .env is already ignored by git.

# Your MongoDB Atlas connection string. Add the database name "meridian" after the host,
# before the "?", like this:
# mongodb+srv://USERNAME:PASSWORD@CLUSTER-HOST.mongodb.net/meridian?retryWrites=true&w=majority
MONGODB_URI=

# Port the API listens on
PORT=4000
# Password shared by all seven fictional demo accounts (at least 10 characters).
# Used only by "npm run seed". Choose something new, never one you use anywhere else.
DEMO_PASSWORD=
# Secret used to sign login tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# How long a login token stays valid, in minutes (1 to 60). Default is 15.
# ACCESS_TOKEN_MINUTES=15